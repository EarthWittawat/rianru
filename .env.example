# Copy to .env at the repo root and fill in. Never commit the real file.

# OpenAI-compatible chat completions endpoint (vLLM gateway or equivalent).
# VLLM_URL is the base URL; the client appends /chat/completions.
VLLM_URL=https://your-gateway.example/v1
VLLM_MODEL=your-model-name
VLLM_API_KEY=

# Local Neo4j, started by docker compose. The compose file has no default
# password on purpose — it fails loudly if this is missing.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
