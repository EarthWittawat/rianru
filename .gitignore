# Course material lives in folders at the repo root, one per class. Ignore every
# root-level directory that is not part of the project, so no course folder has
# to be named here and a new one is ignored the moment it appears.
/*/
!/docs/
!/server/
!/tasks/
!/web/

# Local progress database
server/data/

# Course index — lists enrolled classes and assignments; regenerate locally
manifest.json
